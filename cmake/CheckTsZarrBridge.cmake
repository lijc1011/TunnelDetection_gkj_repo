cmake_minimum_required(VERSION 3.24)

set(_rebuild "Rebuild the matching TsZarrBridge with the FULL (TensorStore) task, then configure local-app again.")
foreach(_file IN ITEMS "${TSZARR_DLL}" "${TSZARR_IMPLIB}")
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "Missing prebuilt bridge: ${_file}. ${_rebuild}")
    endif()
endforeach()

set(_manifest "${TSZARR_DLL}.build.json")
set(_keys schema config compiler msvc_version toolset pointer_size
    header_sha256 implementation_sha256 dll_sha256 implib_sha256)
set(_schema "1")
set(_config "${TSZARR_CONFIG}")
set(_compiler "${TSZARR_COMPILER}")
set(_msvc_version "${TSZARR_MSVC_VERSION}")
set(_toolset "${TSZARR_TOOLSET}")
set(_pointer_size "${TSZARR_POINTER_SIZE}")
file(SHA256 "${TSZARR_SOURCE_DIR}/TsZarrBridge.h" _header_sha256)
file(SHA256 "${TSZARR_SOURCE_DIR}/TsZarrBridge.cpp" _implementation_sha256)
file(SHA256 "${TSZARR_DLL}" _dll_sha256)
file(SHA256 "${TSZARR_IMPLIB}" _implib_sha256)

if(TSZARR_MODE STREQUAL "WRITE")
    set(_json "{}")
    foreach(_key IN LISTS _keys)
        string(JSON _json SET "${_json}" "${_key}" "\"${_${_key}}\"")
    endforeach()
    file(WRITE "${_manifest}" "${_json}\n")
    message(STATUS "Recorded TsZarrBridge build (${TSZARR_CONFIG})")
elseif(TSZARR_MODE STREQUAL "CHECK")
    if(NOT EXISTS "${_manifest}")
        message(FATAL_ERROR "Unverified prebuilt bridge: ${TSZARR_DLL}. Missing ${_manifest}. ${_rebuild}")
    endif()
    file(READ "${_manifest}" _json)
    foreach(_key IN LISTS _keys)
        string(JSON _actual ERROR_VARIABLE _error GET "${_json}" "${_key}")
        if(NOT _error STREQUAL "NOTFOUND" OR NOT "${_actual}" STREQUAL "${_${_key}}")
            message(FATAL_ERROR "Prebuilt TsZarrBridge mismatch (${TSZARR_CONFIG}, ${_key}): ${TSZARR_DLL}. ${_rebuild}")
        endif()
    endforeach()
    message(STATUS "Verified prebuilt TsZarrBridge (${TSZARR_CONFIG})")
else()
    message(FATAL_ERROR "TSZARR_MODE must be WRITE or CHECK")
endif()
