{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure VS2022",
            "type": "shell",
            "command": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
            "args": [
                "--preset",
                "vs2022-x64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Debug TunnelDetection",
            "type": "shell",
            "command": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake Configure VS2022"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release TunnelDetection",
            "type": "shell",
            "command": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake Configure VS2022"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
